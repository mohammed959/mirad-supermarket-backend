DATABASE_URL="mysql://root:root@localhost:3306/alhathlul_db"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
OTP_EXPIRES_MINUTES=5
# Temporary: force every customer OTP to a fixed value so testers can sign in
# without SMS. Leave blank/unset in production.
DEV_OTP_OVERRIDE=123456

# Bunny CDN convention for brand logos. The backend returns
# ${BUNNY_BRAND_BASE_URL}/{slug}.${BUNNY_BRAND_IMAGE_EXT} for every brand.
# The frontend falls back to DEFAULT_BRAND_IMAGE_URL via <img onError>.
BUNNY_BRAND_BASE_URL=https://your-zone.b-cdn.net/brand
BUNNY_BRAND_IMAGE_EXT=png
DEFAULT_BRAND_IMAGE_URL=https://your-zone.b-cdn.net/brand/default/default.png

# Product images — Cloudinary. Cloudinary Public ID === Product SKU
# (never barcode). Assets are uploaded externally to
# `${CLOUDINARY_PRODUCT_FOLDER}/{sku}`; the backend only derives the
# delivery URL, it never uploads or maps images itself. API key/secret are
# not required for unsigned delivery URLs — kept here for any future
# signed/admin Cloudinary operation. Never commit real values.
# Resulting product URL:
#   https://res.cloudinary.com/${CLOUDINARY_CLOUD_NAME}/image/upload/${CLOUDINARY_PRODUCT_TRANSFORMATIONS}/${CLOUDINARY_PRODUCT_FOLDER}/{sku}
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=mirad/products
CLOUDINARY_PRODUCT_TRANSFORMATIONS=f_auto,q_auto
# Fallback shown when a product has no SKU, or Cloudinary has no asset for
# it (frontend swaps to this via <img onError> — no HEAD check is made).
DEFAULT_PRODUCT_IMAGE_URL=https://your-zone.b-cdn.net/products/default/default.png

# Folder inside the Bunny Storage Zone that receives admin-uploaded
# subcategory images (POST /api/uploads/subcategory-image). No slashes.
BUNNY_SUBCATEGORY_UPLOAD_FOLDER=Subcategories

# ── API Documentation (Swagger / OpenAPI) ────────────────────────────
# Server URLs shown in Swagger UI. They already include the /api base path,
# so every documented endpoint is relative to it. Override per environment;
# defaults are derived from PORT (dev) and the production host (prod).
SWAGGER_SERVER_URL_DEV=http://localhost:4000/api
SWAGGER_SERVER_URL_PROD=https://api.mirad-market.com/api
